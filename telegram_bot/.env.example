# https://my.telegram.org -> API development tools
API_ID=123456
API_HASH=0123456789abcdef0123456789abcdef
# GEMINI_API_KEY va GEMINI_MODEL repo ildizidagi ../.env dan olinadi
# (boshqa loyihalaringiz bilan umumiy). Kerak bo'lsa shu yerda qayta yozish mumkin.

# Siz haqingizda ma'lumot (bot shu asosida javob yozadi)
OWNER_INFO=Ismim Abdulhamid, dasturchiman. Hozir band bo'lishim mumkin.
# Siz o'zingiz chatga yozsangiz, bot shu chatda necha daqiqa jim turadi
PAUSE_MINUTES=10
# Javobdan oldin kutish (soniya) - tabiiyroq ko'rinishi uchun
REPLY_DELAY=3
# Faqat shu user ID larga javob berish (vergul bilan, bo'sh = hammaga)
WHITELIST=
# Bu user ID larga javob bermaslik
BLACKLIST=
